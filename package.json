{
  "name": "@tplnet/homebridge-tahoma",
  "displayName": "Homebridge TaHoma (tplnet fork)",
  "type": "module",
  "version": "2.3.4",
  "description": "Homebridge plugin for TaHoma and Cozytouch services (Somfy, Atlantic, Thermor, Sauter). Maintained fork of dubocr/homebridge-tahoma.",
  "author": "Romain DUBOC <dubocr@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tplnet/homebridge-tahoma.git"
  },
  "bugs": {
    "url": "https://github.com/tplnet/homebridge-tahoma/issues"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts",
    "watch": "npm run build && npm link && nodemon",
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "tahoma",
    "cozytouch",
    "somfy",
    "connexoon"
  ],
  "homepage": "https://github.com/tplnet/homebridge-tahoma#readme",
  "dependencies": {
    "overkiz-client": "npm:@tplnet/overkiz-client@^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "contributors": [
    "tplnet (fork maintainer)"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
