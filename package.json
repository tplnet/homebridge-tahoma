{
  "name": "@tplnet/homebridge-tahoma",
  "displayName": "Homebridge Somfy TaHoma (tplnet)",
  "type": "module",
  "version": "3.0.0-beta.2",
  "description": "Homebridge plugin for Somfy TaHoma (local API and Somfy cloud). Maintained fork of dubocr/homebridge-tahoma.",
  "author": "Romain DUBOC <dubocr@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tplnet/homebridge-tahoma.git"
  },
  "bugs": {
    "url": "https://github.com/tplnet/homebridge-tahoma/issues"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts",
    "watch": "npm run build && npm link && nodemon",
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "smoke": "node scripts/homebridge-smoke.mjs",
    "test": "node test/device-uuid.mjs && node test/smoke.mjs && node test/cloud-client.mjs",
    "version": "node scripts/release-notes.mjs > /dev/null",
    "malware": "node scripts/malware-scan.mjs"
  },
  "keywords": [
    "homebridge-plugin",
    "tahoma",
    "somfy",
    "connexoon"
  ],
  "homepage": "https://github.com/tplnet/homebridge-tahoma#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "contributors": [
    "tplnet (fork maintainer)"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "dependencies": {
    "multicast-dns": "^7.2.5"
  }
}
